VITE_API_URL=http://localhost:4000/api
# If Vite starts on 127.0.0.1 instead of localhost, keep this API URL
# and make sure backend CLIENT_URL/CORS allows that frontend origin.
#
# Production:
# Set VITE_API_URL in Vercel to the active PetNest backend URL, including /api.
# Example: VITE_API_URL=https://petnest-api.onrender.com/api
